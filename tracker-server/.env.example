# Local development only. Vercel provides its own HTTP runtime and does not need PORT.
PORT=4000

MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=fms_tracker

# Generate with: openssl rand -hex 32
TRACKER_API_TOKEN=replace-with-a-long-random-token
